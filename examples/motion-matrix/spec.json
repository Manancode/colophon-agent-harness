      "text": "Cadence"
    },
    {
      "claim_id": "k-s02-narration",
      "kind": "narration",
      "source": "brief.md#positioning",
      "text": "For engineering teams, a red pipeline becomes a ranked list of fixes."
    },
    {
      "claim_id": "k-s03-title",
      "kind": "title",
      "source": "brief.md#problem",
      "text": "Hours Lost Every Week"
    },
    {
      "claim_id": "k-s03-narration",
      "kind": "narration",
      "source": "brief.md#problem",
      "text": "Your team loses hours to failures buried in CI logs."
    },
    {
      "claim_id": "k-s04-title",
      "kind": "title",
      "source": "brief.md#problem",
      "text": "Noise, Not Signal"
    },
    {
      "claim_id": "k-s04-narration",
      "kind": "narration",
      "source": "brief.md#problem",
      "text": "Every failure looks identical until someone reads the log."
    },
    {
      "claim_id": "k-s05-title",
      "kind": "title",
      "source": "brief.md#capability",
      "text": "What It Does"
    },
    {
      "claim_id": "k-s05-narration",
      "kind": "narration",
      "source": "brief.md#capability",
      "text": "Cadence reruns failed jobs, labels them flaky, and clusters every failing test."
    },
    {
      "claim_id": "k-s06-title",
      "kind": "title",
      "source": "brief.md#capability",
      "text": "Inside The Queue"
    },
    {
      "claim_id": "k-s06-narration",
      "kind": "narration",
      "source": "brief.md#capability",
      "text": "Reruns failed jobs, labels flaky tests, and ranks each fix by time saved."
    },
    {
      "claim_id": "k-s07-title",
      "kind": "title",
      "source": "brief.md#differentiator",
      "text": "Logs Are Not Answers"
    },
    {
      "claim_id": "k-s07-narration",
      "kind": "narration",
      "source": "brief.md#differentiator",
      "text": "Logs tell you what broke. Answers tell you what to fix first."
    },
    {
      "claim_id": "k-s08-title",
      "kind": "title",
      "source": "brief.md#differentiator",
      "text": "Two Ways To Spend Monday"
    },
    {
      "claim_id": "k-s08-narration",
      "kind": "narration",
      "source": "brief.md#differentiator",
      "text": "Other tools stop at logs, but Cadence ranks the fix by engineering time saved."
    },
    {
      "claim_id": "k-s09-title",
      "kind": "title",
      "source": "brief.md#proof",
      "text": "Faster To Green"
    },
    {
