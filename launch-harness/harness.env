# ── Launch-harness locked environment ───────────────────────────────────────
# Sourced by setup-harness.sh before ANY render-engine / skill command.
# Goal: make governance decisions survive a fresh clone / new machine.
#
# Policy 1 — TELEMETRY OFF (architecture principle: "nothing leaves the machine").
#   LAUNCH_VIDEO_NO_TELEMETRY=1 is the CLI kill-switch. We ALSO flip
#   ~/.config/<engine>/config.json telemetryEnabled:false as a second layer.
LAUNCH_VIDEO_NO_TELEMETRY=1
#
# Policy 2 — GEMINI_API_KEY intentionally LEFT UNSET.
#   We do not add a new external key for marginal description-quality gains.
#   (Descriptive-copy quality is acceptable without it; do not auto-populate.)
# GEMINI_API_KEY=
#
# Use the managed Python (a local TTS model lives there; the CLI must find it).
LAUNCH_VIDEO_PYTHON=<agent-runtime>/binaries/python/envs/default/bin/python
#
# Toolchain locations.
export PATH="$PATH:/opt/homebrew/bin"
